{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {"type": "string"},
    "kind": {"type": "string"},
    "metadata": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "namespace": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "retentionPeriod": {"type": "string"},
        "replicationFactor": {"type": "integer"},
        "preserved": {
          "type": "object",
          "additionalProperties": true
        },
        "clusterConfig": {
          "type": "object",
          "properties": {
            "requestsLoadBalancingEnabled": {"type": "boolean"}
          }
        }
      }
    }
  }
}
